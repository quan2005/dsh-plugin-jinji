{
  "name": "dsh-plugin-jinji-reader",
  "version": "0.1.0",
  "description": "谨迹书房：在 DeepSeek Harness 里浏览 journal 只读 LLM Wiki，一键把文档 @ 引用进会话输入框",
  "private": true,
  "license": "MIT",
  "author": "yanwu",
  "homepage": "https://github.com/quan2005/dsh-plugin-jinji#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quan2005/dsh-plugin-jinji.git",
    "directory": "dsh-plugin"
  },
  "bugs": {
    "url": "https://github.com/quan2005/dsh-plugin-jinji/issues"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/host.js && node --check lib/client.js && node scripts/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "jinji",
    "journal"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
